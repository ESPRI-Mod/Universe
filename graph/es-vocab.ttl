source:GISS-E2.1G source:activity_participation "CMIP",
        "LESFMIP" ;
    source:cohort "Published" ;
    source:institution "NASA-GISS" ;
    source:label "GISS-E2.1G" ;
    source:label_extend "GISS-E2.1G" ;
    source:model_component [ source:aerosol [ source:description "Varies with physics-version (p==1 none, p==3 OMA, p==4 TOMAS, p==5 MATRIX)" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:atmos [ source:description "GISS-E2.1 (2.5x2 degree; 144 x 90 longitude/latitude; 40 levels; top level 0.1 hPa)" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:atmosChem [ source:description "Varies with physics-version (p==1 Non-interactive, p>1 GPUCCINI)" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:land [ source:description "GISS LSM" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:ocean [ source:description "GISS Ocean (GO1, 1 degree; 360 x 180 longitude/latitude; 40 levels; top grid cell 0-10 m)" ;
                    source:native_nominal_resolution "100 km" ;
                    source:version "none" ] ;
            source:seaIce [ source:description "GISS SI" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ] ;
    source:release_year "2019"^^<xsd:integer> ;
    source:source_id "GISS-E2-1-G" .

