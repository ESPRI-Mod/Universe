<http://es-vocab.ipsl.fr/forcing_index/forcing_index:one_digit> forcing:regex "^f\\d$" .

forcing:multiple_digit forcing:regex "^f\\d*$" .

grid:gm grid:description "global mean data" ;
    grid:label "gm" .

grid:gn grid:description "data reported on a model's native grid" ;
    grid:label "gn" .

