                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:landIce [ source:description "CISM" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:ocean [ source:description "MICOM (1 degree resolution; 360 x 384; 70 levels; top grid cell minimum 0-2.5 m [native model uses hybrid density and generic upper-layer coordinate interpolated to z-level for contributed data])" ;
                    source:native_nominal_resolution "100 km" ;
                    source:version "none" ] ;
            source:ocnBgchem [ source:description "HAMOCC" ;
                    source:native_nominal_resolution "100 km" ;
                    source:version "none" ] ;
            source:seaIce [ source:description "CICE" ;
                    source:native_nominal_resolution "100 km" ;
                    source:version "none" ] ] ;
    source:release_year "2017"^^<xsd:integer> ;
    source:source_id "NorESM2-LM" .

