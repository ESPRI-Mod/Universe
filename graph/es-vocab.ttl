                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:atmos [ source:description "CAM-OSLO (2 degree resolution; 144 x 96; 32 levels; top level 3 mb)" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
            source:atmosChem [ source:description "OsloChemSimp" ;
                    source:native_nominal_resolution "250 km" ;
                    source:version "none" ] ;
