temporal_label:tavg temporal_label:description "time-average" ;
    temporal_label:label "tavg" .

temporal_label:tclmdc temporal_label:description "diurnal cycle climatology" ;
    temporal_label:label "tclmdc" .

temporal_label:ti temporal_label:description "time-independent data (no time coordinate)" ;
    temporal_label:label "ti" .

temporal_label:tpt temporal_label:description "synoptically sampled (i.e., a snapshot, referred to as 'point' data in the CF conventions cell_methods)" ;
    temporal_label:label "tpt" .

temporal_label:tstat temporal_label:description "statistical measure (e.g., a maximum or minimum value), other than those, like 'mean value' already accounted for by other options above." ;
    temporal_label:label "tstat" .

temporal_label:tsum temporal_label:description "accumulation, sum, or integral over the reporting interval" ;
    temporal_label:label "tsum" .

time_range:monthly time_range:description "Regex to validate time range like YYYYMM-YYYYMM" ;
    time_range:parts <timebound:six_digits> ;
    time_range:separator "-" .

timebound:eight_digit timebound:regex "^\\d{8}$" .

timebound:fourteen_digit timebound:regex "^\\d{14}$" .

timebound:six_digit timebound:regex "^\\d{6}$" .

timebound:ten_digit timebound:regex "^\\d{10}$" .

timebound:twelve_digit timebound:regex "^\\d{12}$" .

variable:abs550aer variable:cmip_acronym "abs550aer" ;
    variable:long_name "Ambient Aerosol Absorption Optical Thickness at 550nm" ;
    variable:standard_name "atmosphere_absorption_optical_thickness_due_to_ambient_aerosol_particles" ;
    variable:type "real" ;
    variable:units "1" .

variable:acabf variable:cmip_acronym "acabf" ;
    variable:long_name "Surface Mass Balance Flux" ;
    variable:standard_name "land_ice_surface_specific_mass_balance_flux" ;
    variable:type "real" ;
    variable:units "kg m-2 s-1" .

variable:acabfIs variable:cmip_acronym "acabfIs" ;
    variable:long_name "Ice Sheet Surface Mass Balance Flux" ;
    variable:standard_name "land_ice_surface_specific_mass_balance_flux" ;
    variable:type "real" ;
    variable:units "kg m-2 s-1" .

